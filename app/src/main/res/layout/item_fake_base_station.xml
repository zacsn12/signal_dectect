<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Operator & Risk Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_operator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中国移动"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_pill_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_radio_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="4G LTE"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tv_serving_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="主服"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#059669"
                android:background="@drawable/bg_pill_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_risk_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正常基站"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#059669"
                android:background="@drawable/bg_pill_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Cell Parameters Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cell_identity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAC/TAC: 41235 · CID: 12345678"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tv_cell_sub_identity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="PCI: 235 · 频点: 627264 · PLMN: 46000"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="#64748B" />
            </LinearLayout>

            <!-- Signal dBm & Quality -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_signal_dbm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-78 dBm"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#0A1E36" />

                <TextView
                    android:id="@+id/tv_signal_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="信号良好"
                    android:textSize="11sp"
                    android:textColor="#64748B" />
            </LinearLayout>
        </LinearLayout>

        <!-- Anomaly Warning Box (Only visible when suspicious or dangerous) -->
        <LinearLayout
            android:id="@+id/layout_anomaly_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="#FEF2F2"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_anomaly_reasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 位置区码异常 (LAC=0)\n• 孤立高场强2G基站"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
