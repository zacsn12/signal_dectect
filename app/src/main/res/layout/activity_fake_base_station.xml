<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top 2/5ths Area: Radar display & Security Shield -->
    <FrameLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#0A1E36">

        <!-- Concentric Radar Rings -->
        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_radar_ring" />

        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_radar_ring" />

        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_radar_ring" />

        <!-- Crosshair grid lines -->
        <View
            android:layout_width="280dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:background="#152563EB" />

        <View
            android:layout_width="1dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:background="#152563EB" />

        <!-- Radar Sweep View (rotating) -->
        <View
            android:id="@+id/radar_sweep"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_radar_sweep" />

        <!-- Title centered at the top -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:text="伪基站检测"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.1" />

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="?attr/homeAsUpIndicator"
            app:tint="#FFFFFF" />

        <!-- Center Shield & Security Status -->
        <LinearLayout
            android:id="@+id/layout_security_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/iv_security_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_shield_check"
                app:tint="#10B981" />

            <TextView
                android:id="@+id/tv_security_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="环境安全"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_security_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="未发现伪基站威胁"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#93C5FD" />
        </LinearLayout>

        <!-- Center Inspect Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_scan"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:text="开始排查"
            android:textSize="16sp"
            android:textColor="#0A1E36"
            android:fontFamily="sans-serif-black"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="#0A1E36"
            app:iconSize="20dp"
            app:strokeWidth="2dp"
            app:strokeColor="#2563EB"
            app:elevation="8dp" />

    </FrameLayout>

    <!-- Bottom 3/5ths Area: Base Station Risk List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基站射频与信令分析"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#0A1E36" />

            <TextView
                android:id="@+id/tv_cell_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="监测中: 0"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:fontFamily="sans-serif-bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="准备扫描"
                android:textSize="12sp"
                android:textColor="#2563EB"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_cellular"
                app:tint="#CBD5E1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="未发现周围蜂窝基站"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="请确保已开启手机位置信息并已授权权限"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:gravity="center" />
        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

    </LinearLayout>

</LinearLayout>
